+        } else {
+            path = (rawPath == null || rawPath.isEmpty()) ? "/join.html" : rawPath;
+        }
+        String query = data.getQuery() == null ? "" : "?" + data.getQuery();
+        return "https://" + APP_HOST + path + query;
+    }
