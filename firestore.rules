rules_version = '2';

// Nexa Messenger — Firestore security rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── User profiles ──
    // Owner-only edits, EXCEPT a new signup may credit the referrer's
    // referralCount/referrals (invite system) — nothing else cross-user.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        || (isSignedIn() && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['referralCount', 'referrals']));
      allow delete: if false;
    }

    // ── Presence ──
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);
    }

    // ── Direct messages & call log ──
    match /chats/{msgId} {
      function isParty(data) {
        return isSignedIn()
          && (request.auth.uid == data.from || request.auth.uid == data.to);
      }
      allow read: if resource.data == null || isParty(resource.data);
      allow create: if isSignedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to.size() > 0
                    && (!request.resource.data.keys().hasAny(['text'])
                        || (request.resource.data.text is string
                            && request.resource.data.text.size() <= 10000));
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.to
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['read', 'readAt', 'status', 'react', 'reactions', 'viewOnceOpened']))
        || (request.auth.uid == resource.data.from
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['read', 'readAt', 'status', 'react', 'reactions', 'viewOnceOpened',
                           'edited', 'editedAt', 'text', 'updatedAt'])
            && (!request.resource.data.keys().hasAny(['text'])
                || (request.resource.data.text is string
                    && request.resource.data.text.size() <= 10000)))
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.from;
    }

    // ── 1:1 calls ──
    match /calls/{callId} {
      function isCallParty(data) {
        return isSignedIn()
          && (request.auth.uid == data.from || request.auth.uid == data.to);
      }
      allow read: if resource.data == null || isCallParty(resource.data);
      allow create: if isSignedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string;
      allow update: if isCallParty(resource.data);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.from;
    }

    // ── Voice rooms ──
    match /voice_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn()
                    && request.resource.data.hostId == resource.data.hostId;
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid)
          || (isSignedIn()
              && get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.hostId == request.auth.uid);
      }

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn()
                      && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    // ── Voice room invites ──
    match /voice_invites/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && uid != request.auth.uid
        && request.resource.data.inviter.id == request.auth.uid
        && request.resource.data.keys().hasAll(['room', 'targetUserId', 'inviter']);
      allow delete: if isSignedIn() && uid == request.auth.uid;
    }

    // ── Stories / status ──
    function storyExpired(data) {
      return (data.expireAt is timestamp && request.time > data.expireAt)
          || (data.createdAt is int && request.time.toMillis() > data.createdAt + 86400000);
    }
    match /status/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is int
        && (!('expireAt' in request.resource.data)
            || (request.resource.data.expireAt is timestamp
                && request.resource.data.expireAt > request.time));
      allow update: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['views','likes','reshares'])
      );
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid || storyExpired(resource.data)
      );
    }

    // ── Profile notes ──
    match /profile_notes/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.text is string
        && request.resource.data.createdAt is int;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Disappearing settings ──
    match /disappearingSettings/{keyId} {
      allow read, write: if isSignedIn() && request.auth.uid in keyId.split('_');
    }

    // ── Typing ──
    match /typing/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ── Community Groups ──
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{uid} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && (request.resource.data.senderUid == request.auth.uid
                          || request.resource.data.senderUid == 'system');
        allow update: if isSignedIn();
        allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
      }
    }

    // ── Community Channels ──
    match /channels/{channelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /subscribers/{uid} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (request.auth.uid == uid || request.auth.uid == get(/databases/$(database)/documents/channels/$(channelId)).data.ownerUid);
      }

      match /posts/{postId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();

        match /comments/{commentId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
          allow update: if isSignedIn() && resource.data.authorUid == request.auth.uid;
          allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || request.auth.uid == get(/databases/$(database)/documents/channels/$(channelId)).data.ownerUid);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
