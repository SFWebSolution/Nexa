rules_version = '2';

// Nexa Messenger — Firestore security rules
// Allows cross-device presence, 1:1 voice/video calls, multi-user voice rooms,
// messaging, and stories. Auth is required for all reads/writes.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── User profiles ────────────────────────────────────────────────
    // Anyone signed in can read any profile (so the contact list works).
    // A user can only create/edit their own profile — including their own
    // fcmToken/peerId. (Previously a carve-out let ANY signed-in user write
    // fcmToken/peerId on OTHER users' docs — an attacker could hijack push
    // tokens; that hole is now closed.)
    // Exception: referral credit — a brand-new signup may increment the
    // referrer's referralCount/referrals ONLY (no other fields), so the
    // "invite friends" count works cross-user.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        || (isSignedIn() && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['referralCount', 'referrals']));
      allow delete: if false;
    }

    // ── Presence / online status ─────────────────────────────────────
    // Anyone signed in can read everyone's presence (online dots, last seen).
    // A user only writes their own presence doc.
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);
    }

    // ── Direct messages & call log entries ──────────────────────────
    // A message is readable by either the sender or the recipient.
    // Only the sender may create it — `from` MUST equal the caller's uid,
    // so nobody can send a message impersonating another user.
    match /chats/{msgId} {
      function isParty(data) {
        return isSignedIn()
          && (request.auth.uid == data.from || request.auth.uid == data.to);
      }
      allow read: if resource.data == null || isParty(resource.data);
      allow create: if isSignedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to.size() > 0
                    && (!request.resource.data.keys().hasAny(['text'])
                        || (request.resource.data.text is string
                            && request.resource.data.text.size() <= 10000));
      // Recipient may only mark read/react/open view-once; the sender may
      // additionally edit their own text. Neither may touch other fields.
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.to
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['read', 'readAt', 'status', 'react', 'reactions', 'viewOnceOpened']))
        || (request.auth.uid == resource.data.from
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['read', 'readAt', 'status', 'react', 'reactions', 'viewOnceOpened',
                           'edited', 'editedAt', 'text', 'updatedAt'])
            && (!request.resource.data.keys().hasAny(['text'])
                || (request.resource.data.text is string
                    && request.resource.data.text.size() <= 10000)))
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.from;
    }

    // ── 1:1 voice/video call signaling ──────────────────────────────
    // Caller writes {from,to,status:ringing}. Callee reads & updates
    // status to answered/declined/ended. Either party can read.
    match /calls/{callId} {
      function isCallParty(data) {
        return isSignedIn()
          && (request.auth.uid == data.from || request.auth.uid == data.to);
      }
      allow read: if resource.data == null || isCallParty(resource.data);
      allow create: if isSignedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string;
      allow update: if isCallParty(resource.data);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.from;
    }

    // ── Multi-user voice rooms ──────────────────────────────────────
    // Room metadata: readable by any signed-in user (so invite links work).
    // Created by the host (hostId must be the creator). Update keeps the host
    // fixed (no one can hijack hostId) so only the real host controls the room.
    // Only the HOST may delete the room (host close ends it for everyone).
    match /voice_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn()
                    && request.resource.data.hostId == resource.data.hostId;
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      // Each participant owns its own doc in the subcollection.
      // Anyone in the room can read all participants; a client writes only its own.
      // Delete: a participant deletes their OWN doc (leaving), OR the room HOST
      // deletes ANY participant doc (host-close tears the room down for everyone).
      match /participants/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid)
          || (isSignedIn()
              && get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.hostId == request.auth.uid);
      }

      // In-room text chat messages. Any signed-in user may read; only the
      // sender may create or delete their own message.
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn()
                      && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    // ── Voice room invites ──────────────────────────────────────────
    // An invite is written INTO the invitee's doc (doc id = invitee uid) by
    // the inviter — so create/update is only allowed on SOMEONE ELSE's doc.
    // Only the invitee may delete their own invite doc (accept/decline).
    // The invite must carry a room + the inviter, so arbitrary spam writes are
    // rejected.
    match /voice_invites/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && uid != request.auth.uid
        && request.resource.data.inviter.id == request.auth.uid
        && request.resource.data.keys().hasAll(['room', 'targetUserId', 'inviter']);
      allow delete: if isSignedIn() && uid == request.auth.uid;
    }

    // ── Stories / status ────────────────────────────────────────────
    // Stories auto-expire 24h after posting. Each doc carries an `expireAt`
    // Firestore Timestamp (posted time + 24h); legacy docs use `createdAt`
    // (ms epoch) + 24h. Anyone signed in may DELETE a story once it is past
    // its expiry, so any open client garbage-collects expired stories — they
    // truly disappear after 24h regardless of who posted them. The owner may
    // always delete/update their own story. Non-owners may only update the
    // views/likes/reshares arrays (view/like/reshare recording).
    function storyExpired(data) {
      return (data.expireAt is timestamp && request.time > data.expireAt)
          || (data.createdAt is int && request.time.toMillis() > data.createdAt + 86400000);
    }
    match /status/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is int
        && (!('expireAt' in request.resource.data)
            || (request.resource.data.expireAt is timestamp
                && request.resource.data.expireAt > request.time));
      allow update: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['views','likes','reshares'])
      );
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid || storyExpired(resource.data)
      );
    }

    // ── Profile Notes (24h note shown on a user's profile) ────────────
    // Anyone signed-in can read (to render on profile). Only the owner
    // can write/delete their own note.
    match /profile_notes/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.text is string
        && request.resource.data.createdAt is int;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Per-chat disappearing-message settings ──────────────────────
    // The doc id is the two participants' uids joined with "_" (sorted).
    // Only a member of that pair may read/write the doc.
    match /disappearingSettings/{keyId} {
      allow read, write: if isSignedIn() && request.auth.uid in keyId.split('_');
    }

    // ── Typing indicators ───────────────────────────────────────────
    // Doc id is the TYPER's uid. Anyone signed in may read (to show the
    // "typing…" bar); a user can only write their own typing state.
    match /typing/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
