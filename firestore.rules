rules_version = '2';

// Nexa Messenger — Firestore security rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── User profiles ──
    // Owner-only edits, EXCEPT a new signup may credit the referrer's
    // referralCount/referrals (invite system) — nothing else cross-user.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        || (isSignedIn() && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['referralCount', 'referrals']));
      allow delete: if false;
    }

    // ── Presence ──
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);
    }

    // ── Direct messages & call log ──
    match /chats/{msgId} {
      function isParty(data) {
        return isSignedIn()
          && (request.auth.uid == data.from || request.auth.uid == data.to);
      }
      allow read: if resource.data == null || isParty(resource.data);
      allow create: if isSignedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to.size() > 0
                    && (!request.resource.data.keys().hasAny(['text'])
                        || (request.resource.data.text is string
                            && request.resource.data.text.size() <= 10000))
                                        && (!('type' in request.resource.data)
                        || request.resource.data.type != 'invite'
                        || (request.resource.data.type == 'invite'
                            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.allowInvites == true));
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.to
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['read', 'readAt', 'status', 'react', 'reactions', 'viewOnceOpened', 'pollOptions']))
        || (request.auth.uid == resource.data.from
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['read', 'readAt', 'status', 'react', 'reactions', 'viewOnceOpened', 'pollOptions',
                           'edited', 'editedAt', 'text', 'updatedAt'])
            && (!request.resource.data.keys().hasAny(['text'])
                || (request.resource.data.text is string
                    && request.resource.data.text.size() <= 10000)))
      );
      // Either party may delete a message in their own conversation. This is
      // what makes "Clear chat" actually clear BOTH sides (like WhatsApp) and
      // lets the disappearing-message sweep purge the peer's expired messages
      // too — not just the sender's own.
      allow delete: if isParty(resource.data);
    }

    // ── 1:1 calls ──
    match /calls/{callId} {
      function isCallParty(data) {
        return isSignedIn()
          && (request.auth.uid == data.from || request.auth.uid == data.to);
      }
      allow read: if resource.data == null || isCallParty(resource.data);
      allow create: if isSignedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string;
      allow update: if isCallParty(resource.data);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.from;
    }

    // ── Voice rooms ──
    match /voice_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn()
                    && request.resource.data.hostId == resource.data.hostId;
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid)
          || (isSignedIn()
              && get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.hostId == request.auth.uid);
      }

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn()
                      && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    // ── Voice room invites ──
    match /voice_invites/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && uid != request.auth.uid
        && request.resource.data.inviter.id == request.auth.uid
        && request.resource.data.keys().hasAll(['room', 'targetUserId', 'inviter']);
      allow delete: if isSignedIn() && uid == request.auth.uid;
    }

    // ── Stories / status ──
    function storyExpired(data) {
      return (data.expireAt is timestamp && request.time > data.expireAt)
          || (data.createdAt is int && request.time.toMillis() > data.createdAt + 86400000);
    }
    match /status/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is int
        && (!('expireAt' in request.resource.data)
            || (request.resource.data.expireAt is timestamp
                && request.resource.data.expireAt > request.time));
      allow update: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['views','likes','reshares'])
      );
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid || storyExpired(resource.data)
      );
    }

    // ── Connections (1:1 connect requests) ──
    // One doc per user pair, id = the two uids sorted and joined with "_".
    // A request starts "pending"; only the recipient may flip it to
    // "accepted". Either member may delete (decline / cancel / disconnect).
    // Auto-connect migration writes already-"accepted" docs.
    match /connections/{connId} {
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.members;
      }
      function validPair() {
        return request.resource.data.members is list
          && request.resource.data.members.size() == 2
          && request.auth.uid in request.resource.data.members;
      }
      allow read: if isMember();
      allow create: if isSignedIn()
                    && validPair()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to != request.auth.uid
                    && request.resource.data.to in request.resource.data.members
                    && (request.resource.data.status == 'pending'
                        || request.resource.data.status == 'accepted');
      allow update: if isMember()
                    && request.auth.uid == resource.data.to
                    && request.resource.data.members == resource.data.members
                    && request.resource.data.from == resource.data.from
                    && request.resource.data.to == resource.data.to
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isMember();
    }

    // ── Profile notes ──
    match /profile_notes/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.text is string
        && request.resource.data.createdAt is int;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Disappearing settings ──
    match /disappearingSettings/{keyId} {
      allow read, write: if isSignedIn() && request.auth.uid in keyId.split('_');
    }

    // ── Typing ──
    match /typing/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ── Community Groups ──
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{uid} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && (request.resource.data.senderUid == request.auth.uid
                          || request.resource.data.senderUid == 'system');
        allow update: if isSignedIn();
        allow delete: if isSignedIn()
                      && (resource.data.senderUid == request.auth.uid
                          || request.auth.uid == resource.data.createdBy
                          || request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid
                          || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins);
      }
    }

    // ── Community Channels ──
    match /channels/{channelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /subscribers/{uid} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (request.auth.uid == uid || request.auth.uid == get(/databases/$(database)/documents/channels/$(channelId)).data.ownerUid);
      }

      match /posts/{postId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();

        match /comments/{commentId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
          allow update: if isSignedIn() && resource.data.authorUid == request.auth.uid;
          allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || request.auth.uid == get(/databases/$(database)/documents/channels/$(channelId)).data.ownerUid);
        }
      }
    }

    // ── Nexa Wallet: in-app notification history (per user) ──
    // Each signed-in user keeps their OWN history doc. Only the owner can
    // read/create/update it, so no cross-user data is involved.
    match /notifHistory/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete:
          if isSignedIn() && request.auth.uid == uid;
    }

    // ── Videos (Moments → Videos) ──
    // PUBLIC feed: any signed-in user can read and watch. NOT connection-gated
    // (the notification fan-out is connection-only, but visibility is public).
    // Only the author may edit/delete; a non-author may ONLY bump the counters
    // (views/likes/commentsCount/shares/saves) — the same affectedKeys().hasOnly
    // pattern the `status` collection uses. A non-author's update that touches
    // any other field is denied.
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is int
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() > 0;
      allow update: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['views','likes','commentsCount','shares','saves'])
      );
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Per-user like marker — no unbounded array on the parent doc.
      match /likes/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
        allow update: if false;
      }

      // Comments — anyone signed in may read; the author owns their comment.
      // Anyone may bump `likes` (mirrors the parent video's views/likes rule);
      // everything else is author-only. The affectedKeys().hasOnly guard is what
      // stops a non-author rewriting the text.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if isSignedIn() && (
          resource.data.uid == request.auth.uid
          || request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['likes'])
        );
        allow delete: if isSignedIn()
          && resource.data.uid == request.auth.uid;
      }

      // Per-user comment-like marker — id "<commentId>_<uid>". Any signed-in user
      // may read (the UI resolves which comments YOU liked in one batched query);
      // create/delete is owner-only so a like cannot be forged or removed for
      // someone else.
      match /comment_likes/{likeId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn()
          && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
