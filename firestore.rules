rules_version = '2';

// Nexa Messenger — Firestore security rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── User profiles ──
    // Owner-only edits, EXCEPT a new signup may credit the referrer's
    // referralCount/referrals (invite system) — nothing else cross-user.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      // Owner edits anything. A non-owner has exactly two narrow exceptions, and
      // each is bound to a SANE DELTA — field-name-only checks let a caller set
      // arbitrary values (followCounts.followers: 999999, referralCount: 1e9) on
      // anybody's profile.
      //
      // 1. A new signup credits their inviter (the referral flow in signup.html).
      //    `referredUsers` grows by exactly the caller, and referralCount moves
      //    by exactly +1.
      allow update: if isOwner(uid)
        // 1a. Referral credit on an inviter whose doc has no referredUsers yet.
        || (isSignedIn()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['referralCount', 'referredUsers', 'referralBonusPoints'])
            && request.resource.data.referralCount == resource.data.referralCount + 1
            && request.resource.data.referredUsers.size() == 1
            && !('referredUsers' in resource.data))
        // 1b. Same, once the inviter already has a referredUsers list: it may
        //     only grow by exactly one entry.
        || (isSignedIn()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['referralCount', 'referredUsers', 'referralBonusPoints'])
            && request.resource.data.referralCount == resource.data.referralCount + 1
            && 'referredUsers' in resource.data
            && request.resource.data.referredUsers.size() == resource.data.referredUsers.size() + 1)
        // 2a. First follow-counter write on a doc that has no followCounts yet.
        || (isSignedIn()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['followCounts'])
            && !('followCounts' in resource.data)
            && request.resource.data.followCounts.keys().hasOnly(['followers', 'following'])
            && (!('followers' in request.resource.data.followCounts)
                || (request.resource.data.followCounts.followers is int
                    && request.resource.data.followCounts.followers >= 0
                    && request.resource.data.followCounts.followers <= 1))
            && (!('following' in request.resource.data.followCounts)
                || !('following' in resource.data.followCounts)
                || request.resource.data.followCounts.following
                   == resource.data.followCounts.following
                || uid == request.auth.uid))
        // 2b. Follow counters are denormalised onto the target's profile so the
        //     stats cost ZERO reads. A non-owner may move `followers` by exactly
        //     one, and only ever bump `following` on their OWN doc.
        || (isSignedIn()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['followCounts'])
            && 'followCounts' in resource.data
            && request.resource.data.followCounts.keys().hasOnly(['followers', 'following'])
            && (!('followers' in request.resource.data.followCounts)
                || !('followers' in resource.data.followCounts)
                || (request.resource.data.followCounts.followers is int
                    && request.resource.data.followCounts.followers >= 0
                    && request.resource.data.followCounts.followers
                       >= resource.data.followCounts.followers - 1
                    && request.resource.data.followCounts.followers
                       <= resource.data.followCounts.followers + 1))
            && (!('following' in request.resource.data.followCounts)
                || !('following' in resource.data.followCounts)
                || request.resource.data.followCounts.following
                   == resource.data.followCounts.following
                || uid == request.auth.uid));
      allow delete: if false;

      // Per-user mirror of the videos this user liked. Written by the liker
      // (owner), readable by anyone signed in so a profile's "Liked" grid can
      // be rendered without a costly collection-group query over `likes`.
      match /liked_videos/{videoId} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }
      // Per-user mirror of the videos this user SAVED (the bookmark action).
      // Same shape and rules as liked_videos: written by the saver (owner),
      // readable by anyone signed in so a profile's "Saved" grid renders from
      // a small per-user subcollection with no collection-group query.
      match /saved_videos/{videoId} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }
    }

    // ── Follows (asymmetric, low-friction) ──
    // One doc per (follower → following) pair. Public accounts auto-accept;
    // protected accounts start `pending` and the target may flip status.
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.following is string
        && request.resource.data.following != request.auth.uid
        && request.resource.data.status in ['pending', 'accepted'];
      // Only the TARGET accepts / rejects. The follower used to be able to
      // rewrite their own follow's status at will.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.following
        && request.resource.data.follower == resource.data.follower
        && request.resource.data.following == resource.data.following
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.follower || request.auth.uid == resource.data.following);
    }

    // ── Presence ──
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);
    }

    // ── Direct messages & call log ──
    match /chats/{msgId} {
      function isParty(data) {
        return isSignedIn()
          && (request.auth.uid == data.from || request.auth.uid == data.to);
      }
      allow read: if resource.data == null || isParty(resource.data);
      allow create: if isSignedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to.size() > 0
                    && (!request.resource.data.keys().hasAny(['text'])
                        || (request.resource.data.text is string
                            && request.resource.data.text.size() <= 10000))
                                        && (!('type' in request.resource.data)
                        || request.resource.data.type != 'invite'
                        || (request.resource.data.type == 'invite'
                            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.allowInvites == true));
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.to
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['read', 'readAt', 'status', 'react', 'reactions', 'viewOnceOpened', 'pollOptions']))
        || (request.auth.uid == resource.data.from
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['read', 'readAt', 'status', 'react', 'reactions', 'viewOnceOpened', 'pollOptions',
                           'edited', 'editedAt', 'text', 'updatedAt'])
            && (!request.resource.data.keys().hasAny(['text'])
                || (request.resource.data.text is string
                    && request.resource.data.text.size() <= 10000)))
      );
      // Either party may delete a message in their own conversation. This is
      // what makes "Clear chat" actually clear BOTH sides (like WhatsApp) and
      // lets the disappearing-message sweep purge the peer's expired messages
      // too — not just the sender's own.
      allow delete: if isParty(resource.data);
    }

    // ── 1:1 calls ──
    match /calls/{callId} {
      function isCallParty(data) {
        return isSignedIn()
          && (request.auth.uid == data.from || request.auth.uid == data.to);
      }
      allow read: if resource.data == null || isCallParty(resource.data);
      allow create: if isSignedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string;
      allow update: if isCallParty(resource.data);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.from;
    }

    // ── Voice rooms ──
    match /voice_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.hostId == request.auth.uid;
      // The host may change anything (but never hand the room to someone else).
      // Anyone else may ONLY append their own uid to invitedUids — the
      // self-service grant an invited user needs. Previously ANY signed-in user
      // could rewrite any room: change the title, hijack hostId, or add
      // arbitrary uids to invitedUids to bypass the invite-only gate.
      allow update: if isSignedIn() && (
        // The host owns every field except the host id itself.
        (request.auth.uid == resource.data.hostId
         && request.resource.data.hostId == resource.data.hostId)
        // A guest may ONLY append their own uid to invitedUids (self-grant).
        // `'invitedUids' in ...` guards a legacy room doc that lacks the field,
        // where `.concat` would otherwise error the whole rule.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedUids'])
            && 'invitedUids' in resource.data
            && request.resource.data.invitedUids
                 == resource.data.invitedUids.concat([request.auth.uid]))
      );
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid)
          || (isSignedIn()
              && get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.hostId == request.auth.uid);
      }

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn()
                      && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    // ── Voice room invites ──
    match /voice_invites/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && uid != request.auth.uid
        && request.resource.data.inviter.id == request.auth.uid
        // The invite must be FOR the doc's owner — otherwise a caller could
        // write an invite to uid A that claims to target B.
        && request.resource.data.targetUserId == uid
        && request.resource.data.keys().hasAll(['room', 'targetUserId', 'inviter']);
      allow delete: if isSignedIn() && uid == request.auth.uid;
    }

    // ── Stories / status ──
    function storyExpired(data) {
      return (data.expireAt is timestamp && request.time > data.expireAt)
          || (data.createdAt is int && request.time.toMillis() > data.createdAt + 86400000);
    }
    match /status/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is int
        && (!('expireAt' in request.resource.data)
            || (request.resource.data.expireAt is timestamp
                && request.resource.data.expireAt > request.time));
      allow update: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['views','likes','reshares'])
      );
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid || storyExpired(resource.data)
      );
    }

    // ── Connections (1:1 connect requests) ──
    // One doc per user pair, id = the two uids sorted and joined with "_".
    // A request starts "pending"; only the recipient may flip it to
    // "accepted". Either member may delete (decline / cancel / disconnect).
    // Auto-connect migration writes already-"accepted" docs.
    match /connections/{connId} {
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.members;
      }
      function validPair() {
        return request.resource.data.members is list
          && request.resource.data.members.size() == 2
          && request.auth.uid in request.resource.data.members;
      }
      allow read: if isMember();
      allow create: if isSignedIn()
                    && validPair()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to != request.auth.uid
                    && request.resource.data.to in request.resource.data.members
                    && (request.resource.data.status == 'pending'
                        || request.resource.data.status == 'accepted');
      allow update: if isMember()
                    && request.auth.uid == resource.data.to
                    && request.resource.data.members == resource.data.members
                    && request.resource.data.from == resource.data.from
                    && request.resource.data.to == resource.data.to
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isMember();
    }

    // ── Profile notes ──
    // Reports — a user files a bug / abuse / idea report; it goes to the admin
    // dashboard through the backend (Admin SDK), never through a browser read.
    // READ is deliberately FALSE for everyone (even the reporter): admin.html
    // signs in ANONYMOUSLY, which is indistinguishable from a normal user, so
    // any browser-side read rule would expose every report to everyone. The
    // admin backend reads them with the Admin SDK and its shared secret.
    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.category is string
        && request.resource.data.createdAt is int
        && request.resource.data.status == 'open';
      allow update, delete: if false;
    }

    match /profile_notes/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.text is string
        && request.resource.data.createdAt is int;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Disappearing settings ──
    match /disappearingSettings/{keyId} {
      allow read, write: if isSignedIn() && request.auth.uid in keyId.split('_');
    }

    // ── Typing ──
    match /typing/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ── Community Groups ──
    // Membership is a denormalised `memberUids` array on the group doc, mirrored
    // by one doc per member in the `members` subcollection. `admins` is the
    // admin list; `ownerUid`/`createdBy` is the creator.
    //
    // SECURITY: `allow update: if isSignedIn()` used to let ANY signed-in user
    // rewrite any group — rename it, empty memberUids, grant themselves admin,
    // or point ownerUid at themselves. Every write is now scoped to a group
    // admin, and a non-admin may only do the three things a normal member
    // legitimately does (join, bump the counters, or leave).
    match /groups/{groupId} {
      function groupData() {
        return get(/databases/$(database)/documents/groups/$(groupId)).data;
      }
      function isGroupAdmin(data) {
        return isSignedIn() && (
          request.auth.uid == data.ownerUid
          || request.auth.uid == data.createdBy
          || ('admins' in data && request.auth.uid in data.admins)
        );
      }
      // Legacy group docs may predate membersCount. A missing key makes
      // `resource.data.membersCount - 1` throw, which denies the WHOLE rule, so
      // the arithmetic check is skipped when either side lacks the field.
      function countMovedBy(data, by) {
        return !('membersCount' in resource.data)
            || !('membersCount' in data)
            || data.membersCount == resource.data.membersCount + by;
      }
      // Ownership is immutable: not even an admin may repoint the group at
      // another owner, which would let an admin hijack a group they don't own.
      function identityKept(data) {
        return data.createdBy == resource.data.createdBy
            && data.ownerUid == resource.data.ownerUid;
      }

      // Current member (or the creator, whose doc may predate the mirror).
      function isGroupMember(data) {
        return isSignedIn() && (
          ('memberUids' in data && request.auth.uid in data.memberUids)
          || request.auth.uid == data.ownerUid
          || request.auth.uid == data.createdBy
        );
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (
        // 1. A group admin may change anything EXCEPT who owns the group.
        (isGroupAdmin(resource.data) && identityKept(request.resource.data))
        // 2. A member may only LEAVE: remove only themselves from memberUids
        //    and decrement the count. Nothing else may change.
        || (isGroupMember(resource.data)
            && identityKept(request.resource.data)
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['memberUids', 'membersCount'])
            && request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid])
            && countMovedBy(request.resource.data, -1))
        // 3. A NON-member may JOIN via an invite link: they may only append
        //    themselves to memberUids and increment the count.
        || (!isGroupMember(resource.data)
            && identityKept(request.resource.data)
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['memberUids', 'membersCount'])
            && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
            && countMovedBy(request.resource.data, 1))
        // 4. A normal member may move ONLY the chat-list preview fields.
        || (isGroupMember(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastMessage', 'lastMessageTime', 'lastSenderName',
                           'lastMentionUids', 'updatedAt']))
      );
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // Membership mirror. A user writes their OWN doc (join / role mirror);
      // a group admin may write anyone's (add member, promote, remove).
      match /members/{uid} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn()
          && (request.auth.uid == uid || isGroupAdmin(groupData()));
      }

      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && (request.resource.data.senderUid == request.auth.uid
                          || request.resource.data.senderUid == 'system');
        // Editing / deleting a group message is for its author and the group's
        // admins. It used to be open to every signed-in user.
        allow update, delete: if isSignedIn() && (
          resource.data.senderUid == request.auth.uid
          || request.auth.uid == resource.data.createdBy
          || isGroupAdmin(groupData())
        );
      }
    }

    // ── Community Channels ──
    // Only the owner and admins may broadcast. Subscribers may only follow /
    // unfollow and bump the counters. `allow create/update/delete: if
    // isSignedIn()` on `posts` let any user post into — or wipe — any channel's
    // feed; that was the single worst hole in this file.
    match /channels/{channelId} {
      function channelData() {
        return get(/databases/$(database)/documents/channels/$(channelId)).data;
      }
      function isChannelAdmin(data) {
        return isSignedIn() && (
          request.auth.uid == data.ownerUid
          || ('admins' in data && request.auth.uid in data.admins)
        );
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (
        isChannelAdmin(resource.data)
        // Follow / unfollow: only the caller's own uid moves in/out of the
        // subscriber list, and the count moves by exactly one.
        || (request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['subscriberUids', 'subscribersCount'])
            && (
              (request.resource.data.subscriberUids == resource.data.subscriberUids.concat([request.auth.uid])
               && request.resource.data.subscribersCount == resource.data.subscribersCount + 1)
              || (request.resource.data.subscriberUids == resource.data.subscriberUids.removeAll([request.auth.uid])
                  && request.resource.data.subscribersCount == resource.data.subscribersCount - 1)
            ))
        // Broadcasting bumps the feed timestamp.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastPostTime']))
      );
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /subscribers/{uid} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn()
          && (request.auth.uid == uid || isChannelAdmin(channelData()));
      }

      match /posts/{postId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && isChannelAdmin(channelData())
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isSignedIn() && (
          isChannelAdmin(channelData())
          // A subscriber may react / view / comment-count, nothing else.
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reactions', 'viewsUids', 'viewsCount', 'commentsCount'])
        );
        allow delete: if isSignedIn() && isChannelAdmin(channelData());

        match /comments/{commentId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
          allow update: if isSignedIn() && resource.data.authorUid == request.auth.uid;
          allow delete: if isSignedIn() && (
            resource.data.authorUid == request.auth.uid
            || isChannelAdmin(channelData())
          );
        }
      }
    }

    // ── Nexa Wallet: in-app notification history (per user) ──
    // Each signed-in user keeps their OWN history doc. Only the owner can
    // read/create/update it, so no cross-user data is involved.
    match /notifHistory/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete:
          if isSignedIn() && request.auth.uid == uid;
    }

    // ── Videos (Moments → Videos) ──
    // PUBLIC feed: any signed-in user can read and watch. NOT connection-gated
    // (the notification fan-out is connection-only, but visibility is public).
    // Only the author may edit/delete; a non-author may ONLY bump the counters
    // (views/likes/commentsCount/shares/saves) — the same affectedKeys().hasOnly
    // pattern the `status` collection uses. A non-author's update that touches
    // any other field is denied.
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is int
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() > 0;
      allow update: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        // A non-author may only nudge the counters, and each must stay a
        // non-negative int within one of its previous value — otherwise
        // `views: 1000000` on someone's video was accepted.
        || (request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['views','likes','commentsCount','shares','saves'])
            && request.resource.data.views is int
            && request.resource.data.views >= resource.data.views - 1
            && request.resource.data.views <= resource.data.views + 1
            && request.resource.data.likes is int
            && request.resource.data.likes >= resource.data.likes - 1
            && request.resource.data.likes <= resource.data.likes + 1
            && request.resource.data.commentsCount is int
            && request.resource.data.commentsCount >= resource.data.commentsCount - 1
            && request.resource.data.commentsCount <= resource.data.commentsCount + 1
            && request.resource.data.shares is int
            && request.resource.data.shares >= resource.data.shares - 1
            && request.resource.data.shares <= resource.data.shares + 1
            && request.resource.data.saves is int
            && request.resource.data.saves >= resource.data.saves - 1
            && request.resource.data.saves <= resource.data.saves + 1)
      );
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Per-user like marker — no unbounded array on the parent doc.
      match /likes/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
        allow update: if false;
      }

      // Per-user share marker — a share counts ONCE per user (like a like),
      // so tapping Share again must not inflate `videos/{id}.shares`. Same
      // shape and rules as /likes: the sharer writes only their own marker.
      match /shares/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
        allow update: if false;
      }

      // Comments — anyone signed in may read; the author owns their comment.
      // Anyone may bump `likes` (mirrors the parent video's views/likes rule);
      // everything else is author-only. The affectedKeys().hasOnly guard is what
      // stops a non-author rewriting the text.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if isSignedIn() && (
          resource.data.uid == request.auth.uid
          || (request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['likes'])
              && request.resource.data.likes is int
              && request.resource.data.likes >= resource.data.likes - 1
              && request.resource.data.likes <= resource.data.likes + 1)
        );
        allow delete: if isSignedIn()
          && resource.data.uid == request.auth.uid;
      }

      // Per-user comment-like marker — id "<commentId>_<uid>". Any signed-in user
      // may read (the UI resolves which comments YOU liked in one batched query);
      // create/delete is owner-only so a like cannot be forged or removed for
      // someone else.
      match /comment_likes/{likeId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn()
          && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
