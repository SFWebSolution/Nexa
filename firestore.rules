rules_version = '2';

// Nexa Messenger — Firestore security rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── User profiles ──
    // Owner-only edits, EXCEPT a new signup may credit the referrer's
    // referralCount/referrals (invite system) — nothing else cross-user.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        || (isSignedIn() && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['referralCount', 'referrals']));
      allow delete: if false;
    }

    // ── Presence ──
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);
    }

    // ── Direct messages & call log ──
    match /chats/{msgId} {
      function isParty(data) {
        return isSignedIn()
          && (request.auth.uid == data.from || request.auth.uid == data.to);
      }
      allow read: if resource.data == null || isParty(resource.data);
      allow create: if isSignedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to.size() > 0
                    && (!request.resource.data.keys().hasAny(['text'])
                        || (request.resource.data.text is string
                            && request.resource.data.text.size() <= 10000))
                                        && (!('type' in request.resource.data)
                        || request.resource.data.type != 'invite'
                        || (request.resource.data.type == 'invite'
                            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.allowInvites == true));
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.to
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['read', 'readAt', 'status', 'react', 'reactions', 'viewOnceOpened', 'pollOptions']))
        || (request.auth.uid == resource.data.from
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['read', 'readAt', 'status', 'react', 'reactions', 'viewOnceOpened', 'pollOptions',
                           'edited', 'editedAt', 'text', 'updatedAt'])
            && (!request.resource.data.keys().hasAny(['text'])
                || (request.resource.data.text is string
                    && request.resource.data.text.size() <= 10000)))
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.from;
    }

    // ── 1:1 calls ──
    match /calls/{callId} {
      function isCallParty(data) {
        return isSignedIn()
          && (request.auth.uid == data.from || request.auth.uid == data.to);
      }
      allow read: if resource.data == null || isCallParty(resource.data);
      allow create: if isSignedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string;
      allow update: if isCallParty(resource.data);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.from;
    }

    // ── Voice rooms ──
    match /voice_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn()
                    && request.resource.data.hostId == resource.data.hostId;
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid)
          || (isSignedIn()
              && get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.hostId == request.auth.uid);
      }

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn()
                      && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    // ── Voice room invites ──
    match /voice_invites/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && uid != request.auth.uid
        && request.resource.data.inviter.id == request.auth.uid
        && request.resource.data.keys().hasAll(['room', 'targetUserId', 'inviter']);
      allow delete: if isSignedIn() && uid == request.auth.uid;
    }

    // ── Stories / status ──
    function storyExpired(data) {
      return (data.expireAt is timestamp && request.time > data.expireAt)
          || (data.createdAt is int && request.time.toMillis() > data.createdAt + 86400000);
    }
    match /status/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is int
        && (!('expireAt' in request.resource.data)
            || (request.resource.data.expireAt is timestamp
                && request.resource.data.expireAt > request.time));
      allow update: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['views','likes','reshares'])
      );
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid || storyExpired(resource.data)
      );
    }

    // ── Profile notes ──
    match /profile_notes/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.text is string
        && request.resource.data.createdAt is int;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Disappearing settings ──
    match /disappearingSettings/{keyId} {
      allow read, write: if isSignedIn() && request.auth.uid in keyId.split('_');
    }

    // ── Typing ──
    match /typing/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ── Community Groups ──
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{uid} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && (request.resource.data.senderUid == request.auth.uid
                          || request.resource.data.senderUid == 'system');
        allow update: if isSignedIn();
        allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
      }
    }

    // ── Community Channels ──
    match /channels/{channelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /subscribers/{uid} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (request.auth.uid == uid || request.auth.uid == get(/databases/$(database)/documents/channels/$(channelId)).data.ownerUid);
      }

      match /posts/{postId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();

        match /comments/{commentId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
          allow update: if isSignedIn() && resource.data.authorUid == request.auth.uid;
          allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || request.auth.uid == get(/databases/$(database)/documents/channels/$(channelId)).data.ownerUid);
        }
      }
    }

    // ── Nexa Wallet: coin ledger (earned coins) ──
    // The amount is NOT client-selectable: it must exactly match the fixed
    // value for the action key, so a hacked client cannot mint coins.
    // Daily caps are enforced server-side via the user's coinStats doc:
    //   users/{uid}.stats.daily.{action}.date == day && .total + amount <= cap
    function nexaCoinAmount(action) {
      return (action == 'daily_login' && 10)
          || (action == 'online_10min' && 10)
          || (action == 'referral' && 50)
          || (action == 'story_like' && 10)
          || (action == 'story_comment' && 10)
          || (action == 'first_message' && 5)
          || (action == 'join_group' && 10)
          || (action == 'create_group' && 20)
          || (action == 'follow_channel' && 5)
          || (action == 'create_channel' && 20)
          || (action == 'new_follower' && 5)
          || (action == 'post_comment' && 10)
          || (action == 'post_view' && 2)
          || 0;
    }
    function nexaCoinDailyCap(action) {
      return (action == 'daily_login' && 10)
          || (action == 'online_10min' && 30)
          || (action == 'referral' && 1000)
          || (action == 'story_like' && 50)
          || (action == 'story_comment' && 50)
          || (action == 'first_message' && 50)
          || (action == 'join_group' && 50)
          || (action == 'create_group' && 100)
          || (action == 'follow_channel' && 50)
          || (action == 'create_channel' && 100)
          || (action == 'new_follower' && 50)
          || (action == 'post_comment' && 50)
          || (action == 'post_view' && 30)
          || 0;
    }
    match /coinLedger/{entryId} {
      allow read: if isSignedIn()
                  && (request.auth.uid == resource.data.uid);
      // The amount is NOT client-selectable: it must exactly match the fixed
      // value for a KNOWN action. Daily caps + duplicate suppression are
      // enforced client-side (with the action whitelist here as a backstop),
      // so a hacked client can never mint arbitrary coin amounts.
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && nexaCoinAmount(request.resource.data.action) == request.resource.data.amount
                    && request.resource.data.amount > 0
                    && request.resource.data.createdAt is int
                    && request.resource.data.day is string
                    && nexaCoinDailyCap(request.resource.data.action) > 0
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned != true;
      allow update, delete: if false;
    }

    // ── Nexa Wallet: withdrawal requests ──
    match /withdrawals/{wId} {
      allow read: if isSignedIn()
                  && (request.auth.uid == resource.data.uid);
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.amountNgn is number
                    && request.resource.data.coins is number
                    && request.resource.data.coins >= 2000
                    && request.resource.data.createdAt is int;
      allow update: if false;   // admin backend approves/rejects (Admin SDK bypasses rules)
      allow delete: if isSignedIn() && request.auth.uid == resource.data.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
